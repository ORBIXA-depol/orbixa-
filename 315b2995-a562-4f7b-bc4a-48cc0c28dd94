import { NextRequest } from "next/server";
import { db } from "@/db";
import { projects, deployments, activities, domains, envVars, redirects, serverlessFns, events } from "@/db/schema";
import { and, desc, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";
import { removeDeploymentFiles, storagePaths } from "@/lib/storage";
import fs from "fs/promises";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

type Ctx = { params: Promise<{ id: string }> };

async function owned(id: string, userId: string) {
  const rows = await db.select().from(projects).where(and(eq(projects.id, id), eq(projects.ownerId, userId))).limit(1);
  return rows[0] ?? null;
}

export async function GET(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const project = await owned(id, user.id);
  if (!project) return json({ error: "Project not found." }, 404);
  const deps = await db.select().from(deployments).where(eq(deployments.projectId, id)).orderBy(desc(deployments.createdAt)).limit(50);
  return json({ project, deployments: deps });
}

export async function PATCH(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const project = await owned(id, user.id);
  if (!project) return json({ error: "Project not found." }, 404);
  let body: { name?: string; spaFallback?: boolean };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const updates: Partial<typeof projects.$inferInsert> = { updatedAt: new Date() };
  if (body.name && body.name.trim()) updates.name = body.name.trim().slice(0, 60);
  if (typeof body.spaFallback === "boolean") updates.spaFallback = body.spaFallback;
  await db.update(projects).set(updates).where(eq(projects.id, id));
  return json({ ok: true });
}

export async function DELETE(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const project = await owned(id, user.id);
  if (!project) return json({ error: "Project not found." }, 404);
  const deps = await db.select({ id: deployments.id }).from(deployments).where(eq(deployments.projectId, id));
  for (const d of deps) {
    await removeDeploymentFiles(d.id);
    await fs.rm(storagePaths.upload(d.id), { force: true }).catch(() => {});
    await fs.rm(storagePaths.buildDir(d.id), { recursive: true, force: true }).catch(() => {});
  }
  await db.delete(events).where(eq(events.projectId, id));
  await db.delete(deployments).where(eq(deployments.projectId, id));
  await db.delete(domains).where(eq(domains.projectId, id));
  await db.delete(envVars).where(eq(envVars.projectId, id));
  await db.delete(redirects).where(eq(redirects.projectId, id));
  await db.delete(serverlessFns).where(eq(serverlessFns.projectId, id));
  await db.delete(projects).where(eq(projects.id, id));
  await db.insert(activities).values({ userId: user.id, action: "project.deleted", detail: `Deleted project “${project.name}” (${project.slug})` });
  return json({ ok: true });
}
