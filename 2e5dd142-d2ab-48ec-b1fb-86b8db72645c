import { NextRequest } from "next/server";
import { db } from "@/db";
import { redirects, projects } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";

export const runtime = "nodejs";
type Ctx = { params: Promise<{ id: string }> };

async function owned(id: string, userId: string) {
  const rows = await db.select().from(projects).where(and(eq(projects.id, id), eq(projects.ownerId, userId))).limit(1);
  return rows[0] ?? null;
}

export async function GET(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const rows = await db.select().from(redirects).where(eq(redirects.projectId, id));
  return json({ redirects: rows });
}

export async function POST(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  let body: { from?: string; to?: string; status?: number };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const from = (body.from ?? "").trim();
  const to = (body.to ?? "").trim();
  if (!from.startsWith("/") || !to.startsWith("/")) return json({ error: "Both paths must start with /" }, 400);
  if (from === to) return json({ error: "Source and destination must differ." }, 400);
  const status = body.status === 302 ? 302 : 301;
  await db.insert(redirects).values({ projectId: id, fromPath: from.slice(0, 200), toPath: to.slice(0, 200), status });
  return json({ ok: true }, 201);
}

export async function DELETE(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const rid = req.nextUrl.searchParams.get("rid");
  if (!rid) return json({ error: "rid required." }, 400);
  await db.delete(redirects).where(and(eq(redirects.id, rid), eq(redirects.projectId, id)));
  return json({ ok: true });
}
