"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { CloudUpload, GitBranch, FileArchive, ExternalLink, RotateCcw, Loader2, CheckCircle2, XCircle, Rocket } from "lucide-react";

function Github({ size = 14 }: { size?: number }) {
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.3 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.69-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
    </svg>
  );
}

type Deployment = {
  id: string; status: string; buildLog: string; error: string | null;
  framework: string; fileCount: number; totalBytes: number; durationMs: number | null; version: number;
};

const SOURCE_TABS = [
  { id: "upload", label: "Upload ZIP", icon: CloudUpload },
  { id: "github", label: "Import GitHub", icon: Github },
  { id: "git", label: "Connect Git Repo", icon: GitBranch },
] as const;

export function DeployWidget({ projectId, slug }: { projectId: string; slug: string }) {
  const [tab, setTab] = useState<(typeof SOURCE_TABS)[number]["id"]>("upload");
  const [file, setFile] = useState<File | null>(null);
  const [dragOver, setDragOver] = useState(false);
  const [repoUrl, setRepoUrl] = useState("");
  const [branch, setBranch] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [deployment, setDeployment] = useState<Deployment | null>(null);
  const logRef = useRef<HTMLDivElement | null>(null);
  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const inputRef = useRef<HTMLInputElement | null>(null);

  const stopPolling = useCallback(() => {
    if (pollRef.current) clearInterval(pollRef.current);
    pollRef.current = null;
  }, []);

  useEffect(() => () => stopPolling(), [stopPolling]);
  useEffect(() => {
    logRef.current?.scrollTo({ top: logRef.current.scrollHeight });
  }, [deployment?.buildLog]);

  const poll = useCallback((depId: string) => {
    stopPolling();
    pollRef.current = setInterval(async () => {
      const res = await fetch(`/api/deployments/${depId}`, { cache: "no-store" });
      if (!res.ok) return;
      const d = await res.json();
      setDeployment(d.deployment);
      if (d.deployment.status === "ready" || d.deployment.status === "failed") stopPolling();
    }, 900);
  }, [stopPolling]);

  const launch = async () => {
    setBusy(true); setError(""); setDeployment(null);
    try {
      let res: Response;
      if (tab === "upload") {
        if (!file) { setError("Choose a .zip archive first."); setBusy(false); return; }
        const fd = new FormData();
        fd.append("file", file);
        res = await fetch(`/api/projects/${projectId}/deploy`, { method: "POST", body: fd });
      } else if (tab === "github") {
        res = await fetch(`/api/projects/${projectId}/deploy/github`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ repoUrl }) });
      } else {
        res = await fetch(`/api/projects/${projectId}/deploy/git`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ repoUrl, branch }) });
      }
      const d = await res.json();
      if (!res.ok) { setError(d.error ?? "Deployment failed to start."); setBusy(false); return; }
      setDeployment(d.deployment);
      poll(d.deployment.id);
    } catch {
      setError("Network error while starting deployment.");
    } finally {
      setBusy(false);
    }
  };

  const live = deployment && (deployment.status === "building" || deployment.status === "queued");

  return (
    <div className="space-y-5">
      <div className="flex gap-2 flex-wrap">
        {SOURCE_TABS.map((t) => (
          <button
            key={t.id}
            onClick={() => setTab(t.id)}
            className={`btn !py-2 !px-4 !text-[13px] ${tab === t.id ? "btn-primary" : "btn-ghost"}`}
            disabled={!!live}
          >
            <t.icon size={14} /> {t.label}
          </button>
        ))}
      </div>

      {tab === "upload" && (
        <div
          onDragOver={(e) => { e.preventDefault(); setDragOver(true); }}
          onDragLeave={() => setDragOver(false)}
          onDrop={(e) => {
            e.preventDefault(); setDragOver(false);
            const f = e.dataTransfer.files?.[0];
            if (f) { if (!f.name.toLowerCase().endsWith(".zip")) setError("Only .zip archives are accepted."); else { setFile(f); setError(""); } }
          }}
          onClick={() => inputRef.current?.click()}
          className={`rounded-2xl border-2 border-dashed p-10 text-center cursor-pointer transition-all ${dragOver ? "border-[var(--violet)] bg-[rgba(124,92,255,.07)] scale-[1.005]" : "border-[var(--line-strong)] hover:border-[var(--violet)]"}`}
        >
          <input ref={inputRef} type="file" accept=".zip,application/zip" className="hidden" onChange={(e) => { const f = e.target.files?.[0]; if (f) { setFile(f); setError(""); } }} />
          <FileArchive size={34} className="mx-auto mb-3 text-[var(--violet-2)]" />
          {file ? (
            <>
              <div className="font-semibold">{file.name}</div>
              <div className="text-xs text-[var(--faint)] mt-1 font-code">{(file.size / 1024 / 1024).toFixed(2)} MB · click to replace</div>
            </>
          ) : (
            <>
              <div className="font-semibold">Drop your <span className="text-[var(--violet-2)]">.zip</span> here, or click to browse</div>
              <div className="text-xs text-[var(--faint)] mt-2">Static HTML, React / Vue / Next builds, monorepos — framework is auto-detected.</div>
            </>
          )}
        </div>
      )}

      {tab === "github" && (
        <div>
          <label className="label">GitHub repository URL</label>
          <input className="input" placeholder="https://github.com/username/repository" value={repoUrl} onChange={(e) => setRepoUrl(e.target.value)} />
          <p className="text-[11px] text-[var(--faint)] mt-2">Public repos work out of the box. Set GITHUB_TOKEN to raise rate limits and enable private repos.</p>
        </div>
      )}

      {tab === "git" && (
        <div className="grid sm:grid-cols-[1fr_180px] gap-3">
          <div>
            <label className="label">Git remote URL</label>
            <input className="input" placeholder="https://gitlab.com/team/app.git" value={repoUrl} onChange={(e) => setRepoUrl(e.target.value)} />
          </div>
          <div>
            <label className="label">Branch (optional)</label>
            <input className="input" placeholder="main" value={branch} onChange={(e) => setBranch(e.target.value)} />
          </div>
        </div>
      )}

      {error && (
        <div className="flex items-center gap-2 text-[13px] text-[var(--red)]"><XCircle size={15} /> {error}</div>
      )}

      <button className="btn btn-primary w-full sm:w-auto !px-8 !py-3" onClick={launch} disabled={busy || !!live}>
        {(busy || live) ? <Loader2 size={15} className="animate-spin" /> : <Rocket size={15} />}
        {live ? "Deploying…" : "Deploy to Production"}
      </button>

      {deployment && (
        <div className="card overflow-hidden">
          <div className="flex items-center gap-3 px-4 py-3 border-b border-[var(--line)]">
            <span className="text-xs font-code text-[var(--faint)]">v{deployment.version} · {deployment.id.slice(0, 8)}</span>
            <span className="ml-auto">
              {deployment.status === "ready" && <span className="inline-flex items-center gap-1.5 text-xs text-[var(--green)] font-semibold"><CheckCircle2 size={14} /> LIVE</span>}
              {deployment.status === "failed" && <span className="inline-flex items-center gap-1.5 text-xs text-[var(--red)] font-semibold"><XCircle size={14} /> FAILED</span>}
              {live && <span className="inline-flex items-center gap-1.5 text-xs text-[var(--amber)] font-semibold"><span className="spinner !w-3 !h-3" /> BUILDING</span>}
            </span>
          </div>
          <div ref={logRef} className="p-4 font-code text-[11.5px] leading-5 max-h-72 overflow-y-auto" style={{ background: "rgba(4,5,10,.75)" }}>
            {(deployment.buildLog || "Waiting for worker…").split("\n").map((l, i) => (
              <div key={i} className="term-line" style={{ color: l.includes("✔") || l.includes("DEPLOYED") ? "#34d399" : l.includes("✖") || l.includes("FAILED") ? "#f87171" : l.includes("worker") || l.includes("Building") ? "#fbbf24" : "#9aa3c2" }}>{l}</div>
            ))}
            {live && <span className="term-cursor text-[var(--violet-2)]" />}
          </div>
          {deployment.status === "ready" && (
            <div className="px-4 py-3.5 border-t border-[var(--line)] flex flex-wrap items-center gap-3">
              <span className="text-sm font-semibold text-[var(--green)]">Deployment live</span>
              <span className="text-xs text-[var(--faint)] font-code">{deployment.fileCount} files · {deployment.durationMs ? `${(deployment.durationMs / 1000).toFixed(1)}s` : ""}</span>
              <a href={`/sites/${slug}/`} target="_blank" rel="noreferrer" className="btn btn-primary !py-2 !px-4 !text-xs ml-auto">
                Visit Site <ExternalLink size={13} />
              </a>
            </div>
          )}
          {deployment.status === "failed" && (
            <div className="px-4 py-3.5 border-t border-[var(--line)] flex items-center gap-3">
              <span className="text-[13px] text-[var(--red)]">{deployment.error}</span>
              <button className="btn btn-ghost !py-2 !px-4 !text-xs ml-auto" onClick={launch}><RotateCcw size={12} /> Try Again</button>
            </div>
          )}
        </div>
      )}
    </div>
  );
}


