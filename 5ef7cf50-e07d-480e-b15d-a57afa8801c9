"use client";

import { useEffect, useRef, useState } from "react";
import Link from "next/link";
import { Search, FileText, ArrowRight, X } from "lucide-react";

type Result = { slug: string; title: string; kicker: string; hits: { heading: string; snippet: string }[]; titleHit: boolean };

export function PolicySearch() {
  const [q, setQ] = useState("");
  const [results, setResults] = useState<Result[] | null>(null);
  const [busy, setBusy] = useState(false);
  const boxRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!q.trim()) { setResults(null); return; }
    setBusy(true);
    const t = setTimeout(async () => {
      const r = await fetch(`/api/legal?search=${encodeURIComponent(q)}`);
      if (r.ok) setResults((await r.json()).results);
      setBusy(false);
    }, 200);
    return () => clearTimeout(t);
  }, [q]);

  useEffect(() => {
    const onClick = (e: MouseEvent) => { if (boxRef.current && !boxRef.current.contains(e.target as Node)) setResults(null); };
    document.addEventListener("click", onClick);
    return () => document.removeEventListener("click", onClick);
  }, []);

  return (
    <div ref={boxRef} className="relative max-w-xl mx-auto">
      <div className="relative">
        <Search size={16} className="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--faint)]" />
        <input
          className="input !pl-11 !py-3.5 !text-[15px]"
          placeholder="Search the policy library… e.g. “refund”, “DMCA”, “encryption”"
          value={q}
          onChange={(e) => setQ(e.target.value)}
          onFocus={() => q.trim() && setResults((r) => r)}
          aria-label="Search policies"
        />
        {q && (
          <button className="absolute right-3.5 top-1/2 -translate-y-1/2 text-[var(--faint)] hover:text-[var(--text)]" onClick={() => { setQ(""); setResults(null); }} aria-label="Clear">
            <X size={15} />
          </button>
        )}
      </div>
      {results !== null && (
        <div className="absolute z-30 inset-x-0 mt-2 card p-2 max-h-[380px] overflow-y-auto shadow-2xl" style={{ background: "var(--panel-solid)" }}>
          {busy && <div className="px-4 py-3 text-xs text-[var(--faint)]">Searching…</div>}
          {!busy && results.length === 0 && <div className="px-4 py-3 text-xs text-[var(--faint)]">No matches — try different keywords.</div>}
          {!busy && results.map((r) => (
            <Link key={r.slug} href={`/legal/${r.slug}`} className="block px-3.5 py-3 rounded-xl hover:bg-[rgba(124,92,255,.07)] transition-colors">
              <div className="flex items-center gap-2 text-sm font-semibold">
                <FileText size={13} className="text-[var(--violet-2)]" /> {r.title}
                <ArrowRight size={12} className="ml-auto text-[var(--faint)]" />
              </div>
              {r.hits.map((h, i) => (
                <div key={i} className="mt-1.5 text-[11.5px] text-[var(--muted)] leading-snug">
                  <span className="text-[var(--violet-2)] font-code text-[10px]">{h.heading}</span>
                  <span className="block mt-0.5 font-code text-[10.5px] opacity-80">{h.snippet}</span>
                </div>
              ))}
            </Link>
          ))}
        </div>
      )}
    </div>
  );
}
