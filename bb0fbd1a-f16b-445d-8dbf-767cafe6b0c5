import crypto from "crypto";
import { platformSecret } from "./platform";

async function key() {
  const s = await platformSecret();
  return crypto.createHash("sha256").update(s).digest();
}

/** AES-256-GCM encryption for environment variables / secrets at rest. */
export async function encryptSecret(plain: string) {
  const iv = crypto.randomBytes(12);
  const cipher = crypto.createCipheriv("aes-256-gcm", await key(), iv);
  const enc = Buffer.concat([cipher.update(plain, "utf8"), cipher.final()]);
  const tag = cipher.getAuthTag();
  return `${iv.toString("base64")}.${tag.toString("base64")}.${enc.toString("base64")}`;
}

export async function decryptSecret(payload: string) {
  try {
    const [ivB, tagB, dataB] = payload.split(".");
    const decipher = crypto.createDecipheriv("aes-256-gcm", await key(), Buffer.from(ivB, "base64"));
    decipher.setAuthTag(Buffer.from(tagB, "base64"));
    return Buffer.concat([decipher.update(Buffer.from(dataB, "base64")), decipher.final()]).toString("utf8");
  } catch {
    return "";
  }
}

export function sha(s: string) {
  return crypto.createHash("sha256").update(s).digest("hex").slice(0, 24);
}
