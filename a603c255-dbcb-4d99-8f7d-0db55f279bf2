        <div className="absolute -bottom-32 -left-32 w-[480px] h-[480px] rounded-full aurora" style={{ background: "radial-gradient(circle, rgba(124,92,255,.2), transparent 65%)" }} />
        <Link href="/" className="relative"><Logo size={34} /></Link>
        <div className="relative">
          <h2 className="font-display font-bold text-4xl leading-tight">Build. Deploy. Scale.<br /><span className="grad-text">Beyond Limits.</span></h2>
