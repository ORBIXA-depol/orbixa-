function GoogleButton() {
  const [cfg, setCfg] = useState<{ google: boolean } | null>(null);
  const [msg, setMsg] = useState<string | null>(null);
  useEffect(() => {
    fetch("/api/auth/config").then((r) => r.json()).then(setCfg).catch(() => setCfg({ google: false }));
  }, []);
  return (
    <>
      <button
        type="button"
        onClick={async () => {
          if (!cfg?.google) {
            setMsg("Google sign-in requires GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET env vars on this instance.");
            return;
          }
          const res = await fetch("/api/auth/google");
          if (res.redirected) window.location.href = res.url;
          else {
            const d = await res.json().catch(() => null);
            window.location.href = "/api/auth/google";
            void d;
          }
        }}
        className="btn btn-ghost w-full !py-3"
      >
        <GoogleMark /> Continue with Google
      </button>
      {msg && <p className="mt-2 text-[11px] text-[var(--amber)] text-center">{msg}</p>}
    </>
  );
}

