import { NextRequest } from "next/server";
import { db } from "@/db";
import { envVars, projects, activities } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";
import { encryptSecret, decryptSecret } from "@/lib/crypto";

export const runtime = "nodejs";
type Ctx = { params: Promise<{ id: string }> };

async function owned(id: string, userId: string) {
  const rows = await db.select().from(projects).where(and(eq(projects.id, id), eq(projects.ownerId, userId))).limit(1);
  return rows[0] ?? null;
}

export async function GET(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const reveal = _req.nextUrl.searchParams.get("reveal") === "1";
  const rows = await db.select().from(envVars).where(eq(envVars.projectId, id));
  const out = [];
  for (const r of rows) {
    const val = await decryptSecret(r.valueEnc);
    out.push({
      id: r.id,
      key: r.key,
      updatedAt: r.updatedAt,
      value: reveal ? val : val.length <= 4 ? "••••" : `${val.slice(0, 2)}${"•".repeat(Math.min(8, val.length - 2))}`,
    });
  }
  return json({ env: out });
}

export async function POST(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  let body: { key?: string; value?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const key = (body.key ?? "").trim();
  if (!/^[A-Z_][A-Z0-9_]*$/i.test(key)) return json({ error: "Keys must be ALPHANUMERIC_WITH_UNDERSCORES." }, 400);
  const value = body.value ?? "";
  if (value.length > 4096) return json({ error: "Value too long (max 4 KB)." }, 400);
  const existing = await db.select().from(envVars).where(and(eq(envVars.projectId, id), eq(envVars.key, key))).limit(1);
  const enc = await encryptSecret(value);
  if (existing[0]) await db.update(envVars).set({ valueEnc: enc, updatedAt: new Date() }).where(eq(envVars.id, existing[0].id));
  else await db.insert(envVars).values({ projectId: id, key, valueEnc: enc });
  await db.insert(activities).values({ userId: user.id, projectId: id, action: "env.updated", detail: `Set ${key}` });
  return json({ ok: true });
}

export async function DELETE(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const varId = req.nextUrl.searchParams.get("varId");
  if (!varId) return json({ error: "varId required." }, 400);
  await db.delete(envVars).where(and(eq(envVars.id, varId), eq(envVars.projectId, id)));
  return json({ ok: true });
}
