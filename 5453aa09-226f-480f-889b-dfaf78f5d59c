"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  ExternalLink, RefreshCw, RotateCcw, History, BarChart3, Globe, Zap, KeyRound,
  Settings as SettingsIcon, Copy, Check, Eye, EyeOff, Trash2, Plus, PlayCircle,
  TerminalSquare, ArrowRightLeft, Eraser, ShieldAlert, XCircle, CheckCircle2,
} from "lucide-react";
import { StatusBadge, FrameworkBadge, EmptyState, Modal } from "@/components/ui";
import { AreaChart, Donut } from "@/components/charts";
import { DeployWidget } from "./deploy-widget";
import { fmtBytes, timeAgo } from "@/lib/utils";

type Deployment = {
  id: string; version: number; status: string; source: string; sourceMeta: string | null;
  framework: string; fileCount: number; totalBytes: number; durationMs: number | null;
  isActive: boolean; createdAt: string; buildLog: string; error: string | null;
};
type Project = {
  id: string; name: string; slug: string; framework: string; status: string;
  totalDeployments: number; spaFallback: boolean; activeDeploymentId: string | null;
  repoUrl: string | null; createdAt: string; updatedAt: string;
};
type Analytics = {
  series: { day: string; views: number; visitors: number; bandwidth: number; errors: number; avgMs: number }[];
  totals: { views: number; visitors: number; bandwidth: number; errors: number; avgMs: number };
  sources: { source: string; count: number }[];
  countries: { country: string; count: number }[];
  topPages: { path: string; count: number }[];
  devices: { device: string; count: number }[];
  recentErrors: { path: string | null; status: number | null; createdAt: string; count: number }[];
};

const TABS = [
  { id: "overview", label: "Overview", icon: TerminalSquare },
  { id: "deployments", label: "Deployments", icon: History },
  { id: "analytics", label: "Analytics", icon: BarChart3 },
  { id: "domains", label: "Domains", icon: Globe },
  { id: "functions", label: "Functions", icon: Zap },
  { id: "env", label: "Env Vars", icon: KeyRound },
  { id: "settings", label: "Settings", icon: SettingsIcon },
] as const;

function CopyBtn({ text }: { text: string }) {
  const [ok, setOk] = useState(false);
  return (
    <button
      className="text-[var(--faint)] hover:text-[var(--text)] transition-colors"
      onClick={() => { navigator.clipboard?.writeText(text); setOk(true); setTimeout(() => setOk(false), 1200); }}
      aria-label="Copy"
    >
      {ok ? <Check size={13} className="text-[var(--green)]" /> : <Copy size={13} />}
    </button>
  );
}

export function ProjectDetail({ projectId }: { projectId: string }) {
  const router = useRouter();
  const [tab, setTab] = useState<(typeof TABS)[number]["id"]>("overview");
  const [project, setProject] = useState<Project | null>(null);
  const [deployments, setDeployments] = useState<Deployment[]>([]);
  const [loadErr, setLoadErr] = useState("");

  const refresh = useCallback(async () => {
    const res = await fetch(`/api/projects/${projectId}`, { cache: "no-store" });
    if (res.status === 404) { setLoadErr("not found"); return; }
    if (!res.ok) return;
    const d = await res.json();
    setProject(d.project);
    setDeployments(d.deployments);
  }, [projectId]);

  useEffect(() => { refresh(); }, [refresh]);

  if (loadErr) return <EmptyState icon={<XCircle size={22} />} title="Project not found" action={<button className="btn btn-ghost" onClick={() => router.push("/dashboard")}>Back to dashboard</button>} />;
  if (!project) return <div className="space-y-4">{Array.from({ length: 3 }).map((_, i) => <div key={i} className="skeleton h-24" />)}</div>;

  const siteUrl = `/sites/${project.slug}/`;

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-start gap-4">
        <div className="min-w-0">
          <div className="flex items-center gap-3 flex-wrap">
            <h1 className="font-display font-bold text-2xl tracking-tight">{project.name}</h1>
            <FrameworkBadge fw={project.framework} />
            <StatusBadge status={project.status} />
          </div>
          <div className="flex items-center gap-2 mt-2 text-[13px] font-code text-[var(--muted)]">
            <Globe size={13} className="text-[var(--violet-2)]" />
            <span className="truncate">{siteUrl}</span>
            <CopyBtn text={`${window.location.origin}${siteUrl}`} />
            {project.activeDeploymentId && (
              <a href={siteUrl} target="_blank" rel="noreferrer" className="text-[var(--violet-2)] hover:underline inline-flex items-center gap-1">
                <ExternalLink size={12} /> Visit
              </a>
            )}
          </div>
        </div>
        <div className="ml-auto flex items-center gap-2.5">
          {project.activeDeploymentId && (
            <button
              className="btn btn-ghost !py-2 !text-xs"
              onClick={async () => {
                await fetch(`/api/deployments/${project.activeDeploymentId}/redeploy`, { method: "POST" });
                setTab("deployments");
                setTimeout(refresh, 500);
              }}
            >
              <RefreshCw size={13} /> Redeploy Latest
            </button>
          )}
          <button className="btn btn-primary !py-2 !text-xs" onClick={() => setTab("deployments")}>Deployments</button>
        </div>
      </div>

      <div className="flex gap-1.5 overflow-x-auto border-b border-[var(--line)] pb-px">
        {TABS.map((t) => (
          <button
            key={t.id}
            onClick={() => setTab(t.id)}
            className={`flex items-center gap-2 px-4 py-2.5 text-[13px] font-medium whitespace-nowrap border-b-2 transition-colors ${tab === t.id ? "border-[var(--violet)] text-[var(--text)]" : "border-transparent text-[var(--faint)] hover:text-[var(--muted)]"}`}
          >
            <t.icon size={14} /> {t.label}
          </button>
        ))}
      </div>

      {tab === "overview" && <OverviewTab project={project} deployments={deployments} onDeployClick={() => setTab("deployments")} />}
      {tab === "deployments" && <DeploymentsTab project={project} deployments={deployments} refresh={refresh} />}
      {tab === "analytics" && <AnalyticsTab projectId={project.id} />}
      {tab === "domains" && <DomainsTab project={project} />}
      {tab === "functions" && <FunctionsTab project={project} />}
      {tab === "env" && <EnvTab projectId={project.id} />}
      {tab === "settings" && <SettingsTab project={project} refresh={refresh} />}
    </div>
  );
}

/* -------------------------------- Overview ------------------------------- */

