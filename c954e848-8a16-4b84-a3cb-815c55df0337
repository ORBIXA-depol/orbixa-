"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { Logo } from "./logo";
import { ThemeToggle } from "./theme";
import { Menu, X, ArrowRight } from "lucide-react";

const LINKS = [
  { href: "#features", label: "Platform" },
  { href: "#developers", label: "Developers" },
  { href: "#performance", label: "Performance" },
  { href: "#pricing", label: "Pricing" },
  { href: "#faq", label: "FAQ" },
];

export function SiteNav() {
  const [scrolled, setScrolled] = useState(false);
  const [open, setOpen] = useState(false);
  const [me, setMe] = useState<{ name: string } | null>(null);
  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 24);
    window.addEventListener("scroll", onScroll, { passive: true });
    fetch("/api/auth/me").then((r) => (r.ok ? r.json() : null)).then((d) => d?.user && setMe(d.user)).catch(() => {});
    return () => window.removeEventListener("scroll", onScroll);
  }, []);
  return (
    <header className={`fixed top-0 inset-x-0 z-40 transition-all duration-500 ${scrolled ? "py-2.5" : "py-5"}`}>
      <div className={`mx-auto max-w-7xl px-4 transition-all duration-500 ${scrolled ? "max-w-5xl" : ""}`}>
        <nav className={`flex items-center justify-between gap-4 px-4 sm:px-6 h-14 rounded-2xl transition-all duration-500 ${scrolled ? "glass shadow-2xl" : ""}`}>
          <Link href="/" aria-label="ORBIXA home"><Logo size={30} /></Link>
          <div className="hidden md:flex items-center gap-7">
            {LINKS.map((l) => (
              <a key={l.href} href={l.href} className="text-sm text-[var(--muted)] hover:text-[var(--text)] transition-colors font-medium">
                {l.label}
              </a>
            ))}
          </div>
          <div className="hidden md:flex items-center gap-2.5">
            <ThemeToggle />
            {me ? (
              <Link href="/dashboard" className="btn btn-primary !py-2">Dashboard <ArrowRight size={15} /></Link>
            ) : (
              <>
                <Link href="/login" className="btn btn-ghost !py-2">Sign In</Link>
                <Link href="/signup" className="btn btn-primary !py-2">Get Started <ArrowRight size={15} /></Link>
              </>
            )}
          </div>
          <button className="md:hidden text-[var(--muted)]" onClick={() => setOpen(!open)} aria-label="Menu">
            {open ? <X size={22} /> : <Menu size={22} />}
          </button>
        </nav>
        {open && (
          <div className="md:hidden glass rounded-2xl mt-2 p-4 space-y-1 anim-rise" style={{ animationDuration: "0.3s" }}>
            {LINKS.map((l) => (
              <a key={l.href} href={l.href} onClick={() => setOpen(false)} className="block px-3 py-2.5 rounded-lg text-sm text-[var(--muted)] hover:text-[var(--text)] hover:bg-[rgba(124,92,255,.08)]">
                {l.label}
              </a>
            ))}
            <div className="flex gap-2 pt-2">
              <ThemeToggle />
              <Link href="/login" className="btn btn-ghost flex-1 !py-2">Sign In</Link>
              <Link href="/signup" className="btn btn-primary flex-1 !py-2">Get Started</Link>
            </div>
          </div>
        )}
      </div>
    </header>
  );
}
