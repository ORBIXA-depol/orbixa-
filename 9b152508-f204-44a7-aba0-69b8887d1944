import { NextRequest } from "next/server";
import { db } from "@/db";
import { teams, teamMembers, users, activities } from "@/db/schema";
import { and, eq, ne } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";
import { sendEmail, appBaseUrl } from "@/lib/email";

export const runtime = "nodejs";
type Ctx = { params: Promise<{ id: string }> };

async function canManage(teamId: string, userId: string) {
  const t = await db.select().from(teams).where(eq(teams.id, teamId)).limit(1);
  if (!t[0]) return null;
  if (t[0].ownerId === userId) return t[0];
  const m = await db.select().from(teamMembers).where(and(eq(teamMembers.teamId, teamId), eq(teamMembers.userId, userId), eq(teamMembers.role, "admin"))).limit(1);
  return m[0] ? t[0] : null;
}

/** Invite a collaborator by email with a role. */
export async function POST(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const team = await canManage(id, user.id);
  if (!team) return json({ error: "Only team owners/admins can invite members." }, 403);
  let body: { email?: string; role?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const email = (body.email ?? "").trim().toLowerCase();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return json({ error: "Valid email required." }, 400);
  const role = ["admin", "developer", "viewer"].includes(body.role ?? "") ? body.role! : "viewer";
  const existing = await db.select().from(teamMembers).where(and(eq(teamMembers.teamId, id), eq(teamMembers.email, email))).limit(1);
  if (existing[0]) return json({ error: "This person is already on the team." }, 409);
  const target = await db.select().from(users).where(eq(users.email, email)).limit(1);
  await db.insert(teamMembers).values({
    teamId: id,
    email,
    role,
    userId: target[0]?.id ?? null,
    status: target[0] ? "active" : "invited",
  });
  const base = appBaseUrl() || req.nextUrl.origin;
  await sendEmail(email, `You've been invited to ${team.name} on ORBIXA`, `${user.name} invited you to collaborate on team “${team.name}” with the ${role} role.\n\nSign in to accept: ${base}/dashboard/team`);
  await db.insert(activities).values({ userId: user.id, teamId: id, action: "team.invited", detail: `Invited ${email} as ${role}` });
  return json({ ok: true, status: target[0] ? "active" : "invited" }, 201);
}

/** Change a member's role. */
export async function PATCH(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await canManage(id, user.id))) return json({ error: "Forbidden." }, 403);
  let body: { memberId?: string; role?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  if (!["admin", "developer", "viewer"].includes(body.role ?? "")) return json({ error: "Invalid role." }, 400);
  await db.update(teamMembers).set({ role: body.role! }).where(and(eq(teamMembers.id, body.memberId ?? ""), eq(teamMembers.teamId, id)));
  await db.insert(activities).values({ userId: user.id, teamId: id, action: "team.role_changed", detail: `Member role → ${body.role}` });
  return json({ ok: true });
}

/** Remove a member (not the owner). */
export async function DELETE(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const team = await db.select().from(teams).where(eq(teams.id, id)).limit(1);
  if (!team[0]) return json({ error: "Team not found." }, 404);
  const memberId = req.nextUrl.searchParams.get("memberId") ?? "";
  const member = await db.select().from(teamMembers).where(and(eq(teamMembers.id, memberId), eq(teamMembers.teamId, id))).limit(1);
  if (!member[0]) return json({ error: "Member not found." }, 404);
  const self = member[0].email === user.email;
  if (!self && !(await canManage(id, user.id))) return json({ error: "Forbidden." }, 403);
  if (member[0].email === team[0].ownerId) return json({ error: "Cannot remove the team owner." }, 400);
  const ownerRow = await db.select({ email: users.email }).from(users).where(and(eq(users.id, team[0].ownerId), ne(users.email, ""))).limit(1);
  if (member[0].email === ownerRow[0]?.email && !self) return json({ error: "Cannot remove the team owner." }, 400);
  await db.delete(teamMembers).where(eq(teamMembers.id, memberId));
  await db.insert(activities).values({ userId: user.id, teamId: id, action: "team.member_removed", detail: `Removed ${member[0].email}` });
  return json({ ok: true });
}
