import { NextRequest } from "next/server";
import dns from "node:dns/promises";
import { db } from "@/db";
import { domains, projects } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";
import { randomToken } from "@/lib/utils";

export const runtime = "nodejs";
type Ctx = { params: Promise<{ id: string }> };

async function owned(id: string, userId: string) {
  const rows = await db.select().from(projects).where(and(eq(projects.id, id), eq(projects.ownerId, userId))).limit(1);
  return rows[0] ?? null;
}

const DOMAIN_RE = /^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/i;

export async function GET(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const rows = await db.select().from(domains).where(eq(domains.projectId, id));
  return json({ domains: rows });
}

export async function POST(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  let body: { domain?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const domain = (body.domain ?? "").trim().toLowerCase();
  if (!DOMAIN_RE.test(domain)) return json({ error: "Enter a valid domain like app.example.com" }, 400);
  const taken = await db.select({ id: domains.id }).from(domains).where(eq(domains.domain, domain)).limit(1);
  if (taken[0]) return json({ error: "This domain is already attached to a project." }, 409);
  const created = await db.insert(domains).values({ projectId: id, domain, verificationToken: `orbixa-verify=${randomToken(12)}` }).returning();
  return json({ domain: created[0] }, 201);
}

/** Verifies ownership via a real TXT record lookup: orbixa-verify=<token> at _orbixa.{domain} */
export async function PATCH(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  let body: { domainId?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const rows = await db.select().from(domains).where(and(eq(domains.id, body.domainId ?? ""), eq(domains.projectId, id))).limit(1);
  const d = rows[0];
  if (!d) return json({ error: "Domain not found." }, 404);
  try {
    const records = await dns.resolveTxt(`_orbixa.${d.domain}`);
    const flat = records.flat();
    if (flat.includes(d.verificationToken)) {
      await db.update(domains).set({ verified: true }).where(eq(domains.id, d.id));
      return json({ ok: true, verified: true });
    }
    return json({ error: `TXT record _orbixa.${d.domain} must contain "${d.verificationToken}". Found: ${flat.join(", ") || "none"}.` }, 400);
  } catch {
    return json({ error: `DNS lookup failed — add TXT "_orbixa.${d.domain}" = "${d.verificationToken}", wait for propagation, then verify again.` }, 400);
  }
}

export async function DELETE(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const domainId = req.nextUrl.searchParams.get("domainId");
  if (!domainId) return json({ error: "domainId required." }, 400);
  await db.delete(domains).where(and(eq(domains.id, domainId), eq(domains.projectId, id)));
  return json({ ok: true });
}
