import type { Metadata } from "next";
import Link from "next/link";
import { notFound } from "next/navigation";
import { SiteNav } from "@/components/site-nav";
import { SiteFooter } from "@/components/site-footer";
import { POLICIES, getPolicy, currentVersion, lastUpdated, BINDING_POLICY_IDS } from "@/lib/legal";
import { currentUser } from "@/lib/auth";
import { db } from "@/db";
import { policyAcceptances } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { ArrowLeft, ArrowRight, Download, History, CheckCircle2, Mail, FileText } from "lucide-react";
import { AcceptButton } from "@/components/legal/accept-button";

export const dynamic = "force-dynamic";

export async function generateMetadata({ params }: { params: Promise<{ slug: string }> }): Promise<Metadata> {
  const { slug } = await params;
  const p = getPolicy(slug);
  return p ? { title: p.title, description: p.summary } : { title: "Policy" };
}

export default async function PolicyPage({ params }: { params: Promise<{ slug: string }> }) {
  const { slug } = await params;
  const p = getPolicy(slug);
  if (!p) notFound();
  const version = currentVersion(p);
  const binding = BINDING_POLICY_IDS.includes(p.slug);

  const user = await currentUser().catch(() => null);
  let accepted = false;
  if (user) {
    const rows = await db
      .select({ id: policyAcceptances.id })
      .from(policyAcceptances)
      .where(and(eq(policyAcceptances.userId, user.id), eq(policyAcceptances.policyId, p.slug), eq(policyAcceptances.version, version)))
      .limit(1);
    accepted = !!rows[0];
  }

  const idx = POLICIES.findIndex((x) => x.slug === slug);
  const prev = POLICIES[idx - 1];
  const next = POLICIES[idx + 1];

  return (
    <main className="relative min-h-screen">
      <SiteNav />
      <div className="max-w-4xl mx-auto px-6 pt-32 pb-24">
        <Link href="/legal" className="inline-flex items-center gap-1.5 text-xs text-[var(--muted)] hover:text-[var(--text)] transition-colors">
          <ArrowLeft size={13} /> Legal Center
        </Link>

        <header className="mt-6">
          <div className="chip !text-[9.5px] mb-4">{p.kicker.toUpperCase()}</div>
          <h1 className="font-display font-bold tracking-tight text-[clamp(1.9rem,4vw,2.9rem)] leading-tight">{p.title}</h1>
          <p className="mt-4 text-[var(--muted)] leading-relaxed max-w-2xl">{p.summary}</p>

          <div className="mt-6 flex flex-wrap items-center gap-2.5 text-xs">
            <span className="chip">v{version}</span>
            <span className="chip"><History size={10} /> Updated {lastUpdated(p)}</span>
            {binding && <span className="chip !text-[var(--violet-2)] !border-[rgba(124,92,255,.4)]">BINDING FOR ALL ACCOUNTS</span>}
            {accepted && <span className="chip !text-[var(--green)] !border-[rgba(52,211,153,.4)]"><CheckCircle2 size={10} /> YOU ACCEPTED v{version}</span>}
            <a href={`/api/legal/${p.slug}?format=md`} className="btn btn-ghost !py-1.5 !px-3 !text-[11px] ml-auto">
              <Download size={12} /> Download .md
            </a>
            {user && binding && !accepted && <AcceptButton slug={p.slug} version={version} />}
          </div>
        </header>

        <article className="mt-12 space-y-10">
          {p.sections.map((s) => (
            <section key={s.h}>
              <h2 className="font-display font-semibold text-lg tracking-tight flex items-baseline gap-3 border-b border-[var(--line)] pb-3">
                <span className="text-[var(--violet-2)]"><FileText size={14} /></span>{s.h}
              </h2>
              {s.p && <p className="mt-4 text-[14.5px] text-[var(--muted)] leading-[1.85]">{s.p}</p>}
              {s.ul && (
                <ul className="mt-4 space-y-2.5">
                  {s.ul.map((li, i) => (
                    <li key={i} className="flex gap-3 text-[14px] text-[var(--muted)] leading-relaxed">
                      <span className="w-1.5 h-1.5 rounded-full bg-[var(--violet)] mt-[7px] shrink-0" />
                      <span>{li}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </article>

        <section className="mt-14 card p-6">
          <h3 className="font-display font-semibold flex items-center gap-2 mb-4"><History size={15} className="text-[var(--violet-2)]" /> Version history</h3>
          <div className="space-y-0">
            {p.history.slice().reverse().map((h, i) => (
              <div key={h.version} className="flex gap-4 relative pb-5 last:pb-0">
                {i < p.history.length - 1 && <span className="absolute left-[7px] top-5 bottom-0 w-px bg-[var(--line-strong)]" />}
                <span className={`w-[15px] h-[15px] rounded-full mt-1 shrink-0 ${i === 0 ? "bg-[var(--violet)] orb-glow" : "bg-[var(--line-strong)]"}`} />
                <div>
                  <div className="text-sm font-semibold">v{h.version} <span className="text-[var(--faint)] font-code text-[11px] ml-2">{h.date}</span>{i === 0 && <span className="chip !text-[9px] ml-2">CURRENT</span>}</div>
                  <div className="text-[12.5px] text-[var(--muted)] mt-0.5">{h.note}</div>
                </div>
              </div>
            ))}
          </div>
          <p className="text-[12px] text-[var(--faint)] mt-5 flex items-center gap-2"><Mail size={12} /> Questions about this policy: <a href={`mailto:${p.contact}`} className="text-[var(--violet-2)] hover:underline">{p.contact}</a></p>
        </section>

        <nav className="mt-10 grid sm:grid-cols-2 gap-4">
          {prev ? (
            <Link href={`/legal/${prev.slug}`} className="card card-hover p-4 group">
              <div className="text-[10px] text-[var(--faint)] tracking-widest flex items-center gap-1"><ArrowLeft size={10} /> PREVIOUS</div>
              <div className="font-display font-semibold mt-1.5 group-hover:text-[var(--violet-2)] transition-colors">{prev.title}</div>
            </Link>
          ) : <span />}
          {next ? (
            <Link href={`/legal/${next.slug}`} className="card card-hover p-4 group text-right">
              <div className="text-[10px] text-[var(--faint)] tracking-widest flex items-center gap-1 justify-end">NEXT <ArrowRight size={10} /></div>
              <div className="font-display font-semibold mt-1.5 group-hover:text-[var(--violet-2)] transition-colors">{next.title}</div>
            </Link>
          ) : <span />}
        </nav>
      </div>
      <SiteFooter />
    </main>
  );
}
