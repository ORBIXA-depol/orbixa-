import { NextRequest } from "next/server";
import { POLICIES, searchPolicies, currentVersion, lastUpdated, LEGAL_CONTACTS } from "@/lib/legal";
import { json } from "@/lib/auth";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

export async function GET(req: NextRequest) {
  const q = req.nextUrl.searchParams.get("search") ?? "";
  if (q.trim()) return json({ results: searchPolicies(q) });
  return json({
    policies: POLICIES.map((p) => ({
      slug: p.slug, title: p.title, kicker: p.kicker, summary: p.summary,
      version: currentVersion(p), lastUpdated: lastUpdated(p),
      sections: p.sections.length, history: p.history,
    })),
    contacts: LEGAL_CONTACTS,
  });
}
