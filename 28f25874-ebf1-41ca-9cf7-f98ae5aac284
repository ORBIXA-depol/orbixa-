import { NextRequest } from "next/server";
import { db } from "@/db";
import { projects } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json, rateLimit } from "@/lib/auth";
import { launchDeployment } from "@/lib/launch";
import { zipSync } from "fflate";
import { execFile } from "child_process";
import fs from "fs/promises";
import path from "path";
import os from "os";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";
export const maxDuration = 90;

type Ctx = { params: Promise<{ id: string }> };

const SAFE_GIT_URL = /^(https:\/\/|git@)[a-zA-Z0-9._~:\/?#@!$&'()*+,;=%-]+$/;

async function collect(dir: string, base: string, out: Record<string, Uint8Array>, budget: { bytes: number }) {
  const ents = await fs.readdir(dir, { withFileTypes: true });
  for (const e of ents) {
    if (e.name === ".git" || e.name === "node_modules") continue;
    const full = path.join(dir, e.name);
    const rel = base ? `${base}/${e.name}` : e.name;
    if (e.isDirectory()) await collect(full, rel, out, budget);
    else {
      const data = await fs.readFile(full);
      budget.bytes += data.byteLength;
      if (budget.bytes > 200 * 1024 * 1024) throw new Error("Repository content exceeds 200 MB");
      out[rel] = new Uint8Array(data);
    }
    if (Object.keys(out).length > 5000) throw new Error("Repository exceeds 5,000 files");
  }
}

export async function POST(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  if (!rateLimit(`gitdeploy:${user.id}`, 10, 60_000)) return json({ error: "Rate limit reached." }, 429);
  const { id } = await ctx.params;
  const rows = await db.select().from(projects).where(and(eq(projects.id, id), eq(projects.ownerId, user.id))).limit(1);
  if (!rows[0]) return json({ error: "Project not found." }, 404);

  let body: { repoUrl?: string; branch?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const repoUrl = (body.repoUrl ?? rows[0].repoUrl ?? "").trim();
  const branch = (body.branch ?? "").trim();
  if (!repoUrl || !SAFE_GIT_URL.test(repoUrl)) return json({ error: "Provide a valid https:// or git@ repository URL." }, 400);
  if (branch && !/^[a-zA-Z0-9._\/-]+$/.test(branch)) return json({ error: "Invalid branch name." }, 400);

  const workDir = await fs.mkdtemp(path.join(os.tmpdir(), "orbixa-git-"));
  try {
    const args = ["clone", "--depth", "1", "--single-branch"];
    if (branch) args.push("--branch", branch);
    args.push(repoUrl, workDir);
    await new Promise<void>((resolve, reject) => {
      execFile("git", args, { timeout: 75_000, maxBuffer: 4 * 1024 * 1024, env: { ...process.env, GIT_TERMINAL_PROMPT: "0" } }, (err, _stdout, stderr) => {
        if (err) reject(new Error(`git clone failed: ${stderr?.toString().slice(0, 300) || err.message}`));
        else resolve();
      });
    });
    const files: Record<string, Uint8Array> = {};
    await collect(workDir, "", files, { bytes: 0 });
    const zipped = Buffer.from(zipSync(files, { level: 6 }));
    const { deployment, project } = await launchDeployment({
      projectId: id,
      userId: user.id,
      source: "git",
      sourceMeta: `${repoUrl}${branch ? `#${branch}` : ""}`,
      zip: zipped,
    });
    await db.update(projects).set({ repoUrl, source: "git" }).where(eq(projects.id, id));
    return json({ deployment, siteUrl: `/sites/${project.slug}/` }, 201);
  } catch (e) {
    const err = e as { message?: string; status?: number };
    return json({ error: err.message ?? "Git deployment failed" }, err.status ?? 502);
  } finally {
    await fs.rm(workDir, { recursive: true, force: true }).catch(() => {});
  }
}
