@import "tailwindcss";

:root {
  --bg: #05060b;
  --bg-2: #080b16;
  --panel: rgba(13, 17, 32, 0.66);
  --panel-solid: #0d1120;
  --line: rgba(148, 163, 255, 0.12);
  --line-strong: rgba(148, 163, 255, 0.24);
  --text: #eef0fa;
  --muted: #8e97b8;
  --faint: #5b6280;
  --violet: #7c5cff;
  --violet-2: #a78bfa;
  --blue: #38bdf8;
  --green: #34d399;
  --red: #f87171;
  --amber: #fbbf24;
  --glow: rgba(124, 92, 255, 0.45);
  --grid-line: rgba(124, 92, 255, 0.06);
}

[data-theme="light"] {
  --bg: #f6f7fc;
  --bg-2: #eef0fa;
  --panel: rgba(255, 255, 255, 0.72);
  --panel-solid: #ffffff;
  --line: rgba(30, 27, 75, 0.10);
  --line-strong: rgba(30, 27, 75, 0.22);
  --text: #0d1120;
  --muted: #4a5170;
  --faint: #8a90ad;
  --glow: rgba(124, 92, 255, 0.18);
  --grid-line: rgba(124, 92, 255, 0.08);
}

@theme inline {
  --font-display: var(--font-space), system-ui, sans-serif;
  --font-sans: var(--font-inter), system-ui, sans-serif;
  --font-mono: var(--font-jb), ui-monospace, monospace;
  --color-ink: var(--text);
  --color-orb-muted: var(--muted);
  --color-orb-faint: var(--faint);
  --color-orb-violet: var(--violet);
  --color-orb-blue: var(--blue);
  --color-orb-green: var(--green);
  --color-orb-red: var(--red);
  --color-orb-amber: var(--amber);
  --color-orb-bg: var(--bg);
  --color-orb-panel: var(--panel-solid);
}

* { border-color: var(--line); }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  overflow-x: hidden;
  transition: background 0.4s ease, color 0.4s ease;
}

::selection { background: rgba(124, 92, 255, 0.35); }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(124, 92, 255, 0.25); border-radius: 8px; }
::-webkit-scrollbar-thumb:hover { background: rgba(124, 92, 255, 0.5); }

.font-display { font-family: var(--font-display); }
.font-code { font-family: var(--font-mono); }

/* ---------- surfaces ---------- */
.glass {
  background: var(--panel);
  backdrop-filter: blur(18px) saturate(1.4);
  -webkit-backdrop-filter: blur(18px) saturate(1.4);
  border: 1px solid var(--line);
}
.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  backdrop-filter: blur(14px);
  transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
}
.card-hover:hover {
  border-color: var(--line-strong);
  transform: translateY(-3px);
  box-shadow: 0 20px 60px -20px var(--glow);
}

.grad-text {
  background: linear-gradient(92deg, #a78bfa 0%, #7c5cff 34%, #38bdf8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.bg-grid {
  background-image:
    linear-gradient(var(--grid-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
  background-size: 56px 56px;
}

.orb-glow {
  box-shadow: 0 0 24px -4px var(--glow), 0 0 90px -10px var(--glow);
}

/* ---------- buttons ---------- */
.btn {
  display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center;
  font-weight: 600; font-size: 0.9rem; border-radius: 12px;
  padding: 0.7rem 1.4rem; transition: all 0.25s cubic-bezier(.4,0,.2,1);
  border: 1px solid transparent; cursor: pointer; white-space: nowrap;
  text-decoration: none; user-select: none;
}
.btn-primary {
  background: linear-gradient(135deg, #7c5cff, #5b3df0 55%, #4338ca);
  color: #fff; box-shadow: 0 8px 30px -8px rgba(124, 92, 255, 0.65);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 44px -8px rgba(124, 92, 255, 0.8); }
.btn-primary:active { transform: translateY(0); }
.btn-ghost { background: transparent; color: var(--text); border-color: var(--line-strong); }
.btn-ghost:hover { background: rgba(124, 92, 255, 0.1); border-color: var(--violet); }
.btn-danger { background: rgba(248, 113, 113, 0.12); color: var(--red); border-color: rgba(248, 113, 113, 0.3); }
.btn-danger:hover { background: rgba(248, 113, 113, 0.2); }
.btn[disabled] { opacity: 0.5; cursor: not-allowed; transform: none !important; }

.input {
  width: 100%; background: rgba(10, 13, 26, 0.5); border: 1px solid var(--line-strong);
  border-radius: 12px; padding: 0.7rem 1rem; font-size: 0.9rem; color: var(--text);
  outline: none; transition: border-color 0.2s, box-shadow 0.2s;
}
[data-theme="light"] .input { background: #fff; }
.input:focus { border-color: var(--violet); box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.18); }
.input::placeholder { color: var(--faint); }
select.input { appearance: none; }

.label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.4rem; display: block; }

/* ---------- animations ---------- */
@keyframes orbit-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
@keyframes orbit-spin-rev { from { transform: rotate(360deg); } to { transform: rotate(0); } }
@keyframes float-y { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
@keyframes pulse-ring { 0% { transform: scale(0.9); opacity: 0.7; } 100% { transform: scale(1.6); opacity: 0; } }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
@keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
@keyframes aurora {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(6%, -4%) scale(1.12); }
  66% { transform: translate(-5%, 5%) scale(0.94); }
}
@keyframes draw-ring { from { stroke-dashoffset: 1000; } to { stroke-dashoffset: 0; } }

.anim-orbit { animation: orbit-spin 22s linear infinite; }
.anim-orbit-rev { animation: orbit-spin-rev 30s linear infinite; }
.anim-float { animation: float-y 7s ease-in-out infinite; }
.anim-blink { animation: blink 1.1s steps(1) infinite; }
.anim-rise { animation: rise 0.9s cubic-bezier(.16,1,.3,1) both; }
.aurora { animation: aurora 18s ease-in-out infinite; }

.reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.9s cubic-bezier(.16,1,.3,1), transform 0.9s cubic-bezier(.16,1,.3,1); }
.reveal.in { opacity: 1; transform: translateY(0); }

.shimmer-line {
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.35), transparent);
  background-size: 200% 100%;
  animation: shimmer 3s linear infinite;
}

/* terminal */
.term-line { white-space: pre-wrap; word-break: break-word; }
.term-cursor::after { content: "▊"; color: var(--violet-2); animation: blink 1s steps(1) infinite; margin-left: 2px; }

/* spinner */
@keyframes spin { to { transform: rotate(360deg); } }
.spinner { width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.25); border-top-color: currentColor; animation: spin 0.7s linear infinite; display: inline-block; }

.skeleton { position: relative; overflow: hidden; background: rgba(124,92,255,0.06); border-radius: 12px; }
.skeleton::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(148,163,255,0.08), transparent); animation: shimmer 1.6s infinite; background-size: 200% 100%; }

/* misc */
.chip { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--muted); }
.mono-nums { font-variant-numeric: tabular-nums; }
