import { NextRequest, NextResponse } from "next/server";
import { json } from "@/lib/auth";
import crypto from "crypto";

export const runtime = "nodejs";

/** Starts the Google OAuth flow. Requires GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. */
export async function GET(req: NextRequest) {
  const clientId = process.env.GOOGLE_CLIENT_ID;
  if (!clientId) {
    return json({
      error: "Google sign-in is not configured on this instance.",
      required: ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
    }, 503);
  }
  const state = crypto.randomBytes(16).toString("hex");
  const redirectUri = `${new URL(req.url).origin}/api/auth/google/callback`;
  const authUrl = new URL("https://accounts.google.com/o/oauth2/v2/auth");
  authUrl.searchParams.set("client_id", clientId);
  authUrl.searchParams.set("redirect_uri", redirectUri);
  authUrl.searchParams.set("response_type", "code");
  authUrl.searchParams.set("scope", "openid email profile");
  authUrl.searchParams.set("state", state);
  const res = NextResponse.redirect(authUrl.toString());
  res.cookies.set("orbixa_oauth_state", state, { httpOnly: true, sameSite: "lax", secure: process.env.NODE_ENV === "production", maxAge: 600, path: "/" });
  return res;
}
