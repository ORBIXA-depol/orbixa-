import { NextRequest } from "next/server";
import { db } from "@/db";
import { deployments, projects } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

type Ctx = { params: Promise<{ id: string }> };

export async function GET(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const rows = await db
    .select({ deployment: deployments, project: projects })
    .from(deployments)
    .innerJoin(projects, eq(deployments.projectId, projects.id))
    .where(and(eq(deployments.id, id), eq(projects.ownerId, user.id)))
    .limit(1);
  if (!rows[0]) return json({ error: "Deployment not found." }, 404);
  return json({ ...rows[0], siteUrl: `/sites/${rows[0].project.slug}/` });
}
