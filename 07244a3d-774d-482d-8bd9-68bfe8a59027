  { text: "● LIVE — https://orbixa-demo-app.orbixa.site (7.8s end-to-end)", color: "#a78bfa", delay: 600 },
];

function TerminalDemo() {
  const [visible, setVisible] = useState(0);
  const [run, setRun] = useState(0);
  useEffect(() => {
    setVisible(0);
    let i = 0;
    let cancelled = false;
    const next = () => {
      if (cancelled) return;
      if (i < TERM_LINES.length) {
        setVisible(++i);
        setTimeout(next, TERM_LINES[i - 1]?.delay ?? 800);
      } else {
        setTimeout(() => !cancelled && setRun((r) => r + 1), 6000);
      }
    };
    setTimeout(next, 600);
    return () => { cancelled = true; };
  }, [run]);
  return (
    <div className="card !rounded-2xl overflow-hidden text-left shadow-2xl" style={{ background: "rgba(6,8,16,.92)" }}>
      <div className="flex items-center gap-2 px-4 py-3 border-b border-[var(--line)]">
        <span className="w-3 h-3 rounded-full bg-[#ff5f57]" />
        <span className="w-3 h-3 rounded-full bg-[#febc2e]" />
        <span className="w-3 h-3 rounded-full bg-[#28c840]" />
        <span className="ml-3 text-[11px] font-code text-[var(--faint)] flex items-center gap-1.5">
          <Terminal size={12} /> orbixa-cli — interactive demo
        </span>
        <span className="ml-auto chip !text-[9px] !py-0.5">SIMULATED</span>
      </div>
      <div className="p-5 font-code text-[12.5px] sm:text-[13px] leading-6 min-h-[300px]">
        {TERM_LINES.slice(0, visible).map((l, i) => (
          <div key={i} className="term-line" style={{ color: l.color ?? "var(--muted)" }}>{l.text}</div>
        ))}
        <span className="term-cursor text-[var(--violet-2)]" />
      </div>
    </div>
  );
}

