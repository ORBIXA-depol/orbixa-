  { text: "$ orbixa deploy ./my-app --prod", color: "#e6e8f2", delay: 500 },
  { text: "⠋ Resolving project… orbixa-demo-app", color: "#8e97b8", delay: 700 },
  { text: "✔ Archive scanned — 142 files, 0 threats (zip-slip, symlink, size)", color: "#34d399", delay: 900 },
  { text: "✔ Framework detected: NEXT.JS 15 (App Router)", color: "#34d399", delay: 900 },
