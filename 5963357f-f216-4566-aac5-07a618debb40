"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import Link from "next/link";
import {
  LayoutGrid, CloudUpload, Activity, Gauge, HardDrive, Globe2, Plus, Search,
  ArrowUpRight, Boxes, Zap, ExternalLink, Clock, XCircle,
} from "lucide-react";
import { StatusBadge, FrameworkBadge, EmptyState } from "@/components/ui";
import { Meter } from "@/components/charts";
import { DeployWidget } from "./deploy-widget";
import { fmtBytes, fmtNum, timeAgo } from "@/lib/utils";

type Project = {
  id: string; name: string; slug: string; framework: string; status: string;
  totalDeployments: number; updatedAt: string; activeDeployment: { id: string; createdAt: string } | null;
};
type DashData = {
  projects: Project[];
  stats: { projects: number; deploymentsThisMonth: number; readyDeployments: number; pageviewsThisMonth: number; bandwidthThisMonth: number; storageBytes: number };
  plan: { id: string; name: string; maxProjects: number; maxStorageMb: number; maxBandwidthGb: number } | null;
  recentActivity: { id: string; action: string; detail: string | null; createdAt: string }[];
};

function QuickDeployCard() {
  const [drag, setDrag] = useState(false);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [project, setProject] = useState<{ id: string; slug: string; name: string } | null>(null);
  const inputRef = useRef<HTMLInputElement | null>(null);

  const start = async (f: File) => {
    if (!f.name.toLowerCase().endsWith(".zip")) { setError("Only .zip archives are accepted."); return; }
    setBusy(true); setError("");
    const name = f.name.replace(/\.zip$/i, "").replace(/[^a-zA-Z0-9 _-]/g, " ").trim() || "Orbixa Site";
    const res = await fetch("/api/projects", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name, source: "upload" }) });
    const d = await res.json();
    setBusy(false);
    if (!res.ok) { setError(d.error ?? "Could not create project."); return; }
    setProject({ id: d.project.id, slug: d.project.slug, name: d.project.name });
    setTimeout(() => inputDeploy(f), 0);
  };
  // programmatically seed the file into the widget via a hidden state
  const [pendingFile, setPendingFile] = useState<File | null>(null);
  const inputDeploy = (f: File) => setPendingFile(f);

  return (
    <div className="card p-6 relative overflow-hidden">
      <div className="absolute -top-16 -right-16 w-48 h-48 rounded-full" style={{ background: "radial-gradient(circle, rgba(124,92,255,.14), transparent 70%)" }} />
      <div className="flex items-center gap-2 mb-1">
        <Zap size={15} className="text-[var(--violet-2)]" />
        <h3 className="font-display font-semibold">Quick Deploy</h3>
        <span className="chip !text-[9px] ml-auto">ZERO CONFIG</span>
      </div>
      <p className="text-xs text-[var(--muted)] mb-4">Drop a ZIP anywhere below — we create the project, build it and give you a live URL.</p>
      {!project ? (
        <div
          onDragOver={(e) => { e.preventDefault(); setDrag(true); }}
          onDragLeave={() => setDrag(false)}
          onDrop={(e) => { e.preventDefault(); setDrag(false); const f = e.dataTransfer.files?.[0]; if (f) start(f); }}
          onClick={() => inputRef.current?.click()}
          className={`rounded-xl border-2 border-dashed py-7 text-center cursor-pointer transition-all ${drag ? "border-[var(--violet)] bg-[rgba(124,92,255,.07)]" : "border-[var(--line-strong)] hover:border-[var(--violet)]"}`}
        >
          <input ref={inputRef} type="file" accept=".zip" className="hidden" onChange={(e) => { const f = e.target.files?.[0]; if (f) start(f); }} />
          <CloudUpload size={24} className="mx-auto mb-2 text-[var(--violet-2)]" />
          <div className="text-sm font-medium">{busy ? "Creating project…" : "Drop site-archive.zip"}</div>
          <div className="text-[11px] text-[var(--faint)] mt-1">Static sites go live in seconds</div>
        </div>
      ) : (
        <DeployWidgetSeeded projectId={project.id} slug={project.slug} file={pendingFile} projectName={project.name} />
      )}
      {error && <p className="text-xs text-[var(--red)] mt-3 flex items-center gap-1.5"><XCircle size={13} /> {error}</p>}
    </div>
  );
}

function DeployWidgetSeeded({ projectId, slug, file, projectName }: { projectId: string; slug: string; file: File | null; projectName: string }) {
  const [result, setResult] = useState<{ ok: boolean; msg: string } | null>(null);
  const ran = useRef(false);
  useEffect(() => {
    if (!file || ran.current) return;
    ran.current = true;
    (async () => {
      const fd = new FormData();
      fd.append("file", file);
      const res = await fetch(`/api/projects/${projectId}/deploy`, { method: "POST", body: fd });
      if (!res.ok) {
        const d = await res.json().catch(() => null);
        setResult({ ok: false, msg: d?.error ?? "Deploy failed to start." });
      }
    })();
  }, [file, projectId]);
  return (
    <div>
      <div className="text-xs text-[var(--muted)] mb-3">Deploying <b className="text-[var(--text)]">{projectName}</b>…</div>
      <DeployWidget projectId={projectId} slug={slug} />
      {result && !result.ok && <p className="text-xs text-[var(--red)] mt-2">{result.msg}</p>}
      <Link href={`/dashboard/projects/${projectId}`} className="text-xs text-[var(--violet-2)] hover:underline mt-3 inline-block">Open project console →</Link>
    </div>
  );
}

export function DashboardOverview() {
  const [data, setData] = useState<DashData | null>(null);
  const [projects, setProjects] = useState<Project[]>([]);
  const [q, setQ] = useState("");
  const [status, setStatus] = useState("all");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetch("/api/dashboard", { cache: "no-store" }).then((r) => r.json()).then(setData).catch(() => {}).finally(() => setLoading(false));
  }, []);

  useEffect(() => {
    const t = setTimeout(async () => {
      const res = await fetch(`/api/projects?q=${encodeURIComponent(q)}&status=${status}`, { cache: "no-store" });
      if (res.ok) { const d = await res.json(); setProjects(d.projects); }
    }, 250);
    return () => clearTimeout(t);
  }, [q, status]);

  const stats = data?.stats;
  const plan = data?.plan;
  const cards = useMemo(() => stats ? [
    { icon: Boxes, label: "Projects", value: fmtNum(stats.projects), sub: plan ? `${plan.maxProjects} included on ${plan.name}` : "", c: "#7c5cff" },
    { icon: CloudUpload, label: "Deployments / month", value: fmtNum(stats.deploymentsThisMonth), sub: `${stats.readyDeployments} live total`, c: "#38bdf8" },
    { icon: Activity, label: "Page views / month", value: fmtNum(stats.pageviewsThisMonth), sub: "Real beacon traffic", c: "#34d399" },
    { icon: Gauge, label: "Bandwidth / month", value: fmtBytes(stats.bandwidthThisMonth), sub: plan ? `${plan.maxBandwidthGb} GB included` : "", c: "#fbbf24" },
  ] : [], [stats, plan]);

  return (
    <div className="space-y-7">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 className="font-display font-bold text-2xl sm:text-3xl tracking-tight">Mission Control</h1>
          <p className="text-sm text-[var(--muted)] mt-1">Everything shipping across your ORBIXA infrastructure, right now.</p>
        </div>
        <Link href="/dashboard/new" className="btn btn-primary"><Plus size={16} /> New Deployment</Link>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-2 xl:grid-cols-4 gap-4">
        {loading
          ? Array.from({ length: 4 }).map((_, i) => <div key={i} className="skeleton h-28" />)
          : cards.map((c) => (
              <div key={c.label} className="card card-hover p-5">
                <div className="flex items-center justify-between">
                  <span className="text-[11px] font-semibold tracking-[0.12em] text-[var(--faint)] uppercase">{c.label}</span>
                  <c.icon size={15} style={{ color: c.c }} />
                </div>
                <div className="font-display font-bold text-2xl sm:text-[28px] mt-2.5 mono-nums">{c.value}</div>
                {c.sub && <div className="text-[11px] text-[var(--faint)] mt-1">{c.sub}</div>}
              </div>
            ))}
      </div>

      {/* Usage meters */}
      {plan && stats && (
        <div className="card p-5 grid sm:grid-cols-3 gap-6">
          <div>
            <div className="flex justify-between text-xs mb-1.5"><span className="text-[var(--muted)] font-medium">Projects</span><span className="font-code text-[var(--faint)]">{stats.projects}/{plan.maxProjects}</span></div>
            <Meter value={stats.projects} max={plan.maxProjects} />
          </div>
          <div>
            <div className="flex justify-between text-xs mb-1.5"><span className="text-[var(--muted)] font-medium flex items-center gap-1"><HardDrive size={11} /> Storage</span><span className="font-code text-[var(--faint)]">{fmtBytes(stats.storageBytes)}/{plan.maxStorageMb} MB</span></div>
            <Meter value={stats.storageBytes} max={plan.maxStorageMb * 1024 * 1024} color="var(--blue)" />
          </div>
          <div>
            <div className="flex justify-between text-xs mb-1.5"><span className="text-[var(--muted)] font-medium flex items-center gap-1"><Globe2 size={11} /> Bandwidth</span><span className="font-code text-[var(--faint)]">{fmtBytes(stats.bandwidthThisMonth)}/{plan.maxBandwidthGb} GB</span></div>
            <Meter value={stats.bandwidthThisMonth} max={plan.maxBandwidthGb * 1024 ** 3} color="var(--green)" />
          </div>
        </div>
      )}

      <div className="grid lg:grid-cols-[1.6fr_1fr] gap-5 items-start">
        {/* Projects */}
        <div className="space-y-4">
          <div className="flex flex-wrap gap-2.5 items-center">
            <div className="relative flex-1 min-w-[200px]">
              <Search size={14} className="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--faint)]" />
              <input className="input !pl-9 !py-2.5 !text-[13px]" placeholder="Search by name or slug…" value={q} onChange={(e) => setQ(e.target.value)} />
            </div>
            <select className="input !w-auto !py-2.5 !text-[13px]" value={status} onChange={(e) => setStatus(e.target.value)}>
              <option value="all">All statuses</option>
              <option value="ready">Live</option>
              <option value="building">Building</option>
              <option value="failed">Failed</option>
              <option value="idle">Idle</option>
            </select>
          </div>

          {loading ? (
            <div className="grid sm:grid-cols-2 gap-4">{Array.from({ length: 4 }).map((_, i) => <div key={i} className="skeleton h-36" />)}</div>
          ) : projects.length === 0 ? (
            <EmptyState
              icon={<LayoutGrid size={22} />}
              title={q || status !== "all" ? "No projects match your filters" : "Launch your first project"}
              hint={q || status !== "all" ? "Try a different search term or status filter." : "Upload a ZIP, import from GitHub, or connect a Git remote — your site will be live in seconds."}
              action={<Link href="/dashboard/new" className="btn btn-primary"><Plus size={15} /> Deploy Now</Link>}
            />
          ) : (
            <div className="grid sm:grid-cols-2 gap-4">
              {projects.map((p) => (
                <Link key={p.id} href={`/dashboard/projects/${p.id}`} className="card card-hover p-5 block group">
                  <div className="flex items-start justify-between gap-2">
                    <div className="min-w-0">
                      <div className="font-semibold truncate group-hover:text-[var(--violet-2)] transition-colors">{p.name}</div>
                      <div className="text-[11px] font-code text-[var(--faint)] mt-0.5 truncate">/sites/{p.slug}/</div>
                    </div>
                    <ArrowUpRight size={15} className="text-[var(--faint)] group-hover:text-[var(--violet-2)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" />
                  </div>
                  <div className="flex items-center gap-2.5 mt-4">
                    <StatusBadge status={p.status} />
                    <FrameworkBadge fw={p.framework} />
                    <span className="text-[10px] text-[var(--faint)] ml-auto font-code">{p.totalDeployments} deploys</span>
                  </div>
                  <div className="flex items-center gap-1.5 text-[11px] text-[var(--faint)] mt-3">
                    <Clock size={11} /> updated {timeAgo(p.updatedAt)}
                    {p.activeDeployment && (
                      <a href={`/sites/${p.slug}/`} target="_blank" rel="noreferrer" onClick={(e) => e.stopPropagation()} className="ml-auto inline-flex items-center gap-1 text-[var(--violet-2)] hover:underline">
                        <ExternalLink size={11} /> open
                      </a>
                    )}
                  </div>
                </Link>
              ))}
            </div>
          )}
        </div>

        {/* Right column */}
        <div className="space-y-5">
          <QuickDeployCard />
          <div className="card p-5">
            <h3 className="font-display font-semibold mb-4 flex items-center gap-2"><Activity size={15} className="text-[var(--violet-2)]" /> Recent Activity</h3>
            {!data ? (
              <div className="space-y-3">{Array.from({ length: 5 }).map((_, i) => <div key={i} className="skeleton h-8" />)}</div>
            ) : data.recentActivity.length === 0 ? (
              <p className="text-[13px] text-[var(--faint)]">No activity yet — deploy something and watch this feed light up.</p>
            ) : (
              <ul className="space-y-3">
                {data.recentActivity.map((a) => (
                  <li key={a.id} className="flex gap-3 text-[13px]">
                    <span className="w-1.5 h-1.5 rounded-full bg-[var(--violet)] mt-1.5 shrink-0" />
                    <div className="min-w-0">
                      <div className="text-[var(--text)] leading-snug">{a.detail ?? a.action}</div>
                      <div className="text-[10px] text-[var(--faint)] font-code mt-0.5">{a.action} · {timeAgo(a.createdAt)}</div>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
