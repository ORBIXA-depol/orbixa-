import { NextRequest } from "next/server";
import { db } from "@/db";
import { deployments, projects } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";
import { readUpload } from "@/lib/storage";
import { launchDeployment } from "@/lib/launch";

export const runtime = "nodejs";
type Ctx = { params: Promise<{ id: string }> };

/** Rebuilds from the deployment's original stored archive. */
export async function POST(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const rows = await db
    .select({ deployment: deployments, project: projects })
    .from(deployments)
    .innerJoin(projects, eq(deployments.projectId, projects.id))
    .where(and(eq(deployments.id, id), eq(projects.ownerId, user.id)))
    .limit(1);
  const row = rows[0];
  if (!row) return json({ error: "Deployment not found." }, 404);
  let zip: Buffer;
  try {
    zip = await readUpload(id);
  } catch {
    return json({ error: "Original archive no longer available; upload again or re-import." }, 410);
  }
  try {
    const { deployment, project } = await launchDeployment({
      projectId: row.project.id,
      userId: user.id,
      source: row.deployment.source as "upload" | "github" | "git",
      sourceMeta: `redeploy of v${row.deployment.version}`,
      zip,
    });
    return json({ deployment, siteUrl: `/sites/${project.slug}/` }, 201);
  } catch (e) {
    const err = e as { message?: string; status?: number };
    return json({ error: err.message ?? "Redeploy failed" }, err.status ?? 500);
  }
}
