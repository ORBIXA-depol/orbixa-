import { NextRequest } from "next/server";
import { db } from "@/db";
import { serverlessFns, projects, activities } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { requireUser, json } from "@/lib/auth";

export const runtime = "nodejs";
type Ctx = { params: Promise<{ id: string }> };

async function owned(id: string, userId: string) {
  const rows = await db.select().from(projects).where(and(eq(projects.id, id), eq(projects.ownerId, userId))).limit(1);
  return rows[0] ?? null;
}

export const FN_TEMPLATE = `// ORBIXA Serverless Function
// Receives: request { method, path, query, headers, body }, env { YOUR_VARS }
// Returns:  { status, headers, body }

module.exports.handler = async (request, env) => {
  return {
    status: 200,
    headers: { "content-type": "application/json" },
    body: JSON.stringify({
      message: "Hello from the ORBIXA edge",
      method: request.method,
      time: new Date().toISOString(),
    }),
  };
};`;

export async function GET(_req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  const p = await owned(id, user.id);
  if (!p) return json({ error: "Project not found." }, 404);
  const rows = await db.select().from(serverlessFns).where(eq(serverlessFns.projectId, id));
  return json({ functions: rows, invokeBase: `/sites/${p.slug}/api/`, template: FN_TEMPLATE });
}

export async function POST(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  let body: { route?: string; code?: string; runtime?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const route = (body.route ?? "").trim().toLowerCase();
  if (!/^[a-z0-9][a-z0-9-]{0,40}$/.test(route)) return json({ error: "Route must be kebab-case (letters, digits, hyphens)." }, 400);
  const code = body.code ?? "";
  if (code.length < 16 || code.length > 20000) return json({ error: "Function code must be 16–20,000 chars." }, 400);
  if (/require\s*\(\s*['"`](child_process|fs|net|process)['"`]/.test(code)) {
    return json({ error: "Blocked module detected. Functions run sandboxed without fs/process access." }, 400);
  }
  const existing = await db.select().from(serverlessFns).where(and(eq(serverlessFns.projectId, id), eq(serverlessFns.route, route))).limit(1);
  if (existing[0]) {
    await db.update(serverlessFns).set({ code, runtime: body.runtime === "serverless" ? "serverless" : "edge" }).where(eq(serverlessFns.id, existing[0].id));
  } else {
    await db.insert(serverlessFns).values({ projectId: id, name: route, route, code, runtime: body.runtime === "serverless" ? "serverless" : "edge" });
  }
  await db.insert(activities).values({ userId: user.id, projectId: id, action: "function.deployed", detail: `api/${route}` });
  return json({ ok: true }, 201);
}

export async function DELETE(req: NextRequest, ctx: Ctx) {
  const user = await requireUser();
  if (!user) return json({ error: "Unauthorized" }, 401);
  const { id } = await ctx.params;
  if (!(await owned(id, user.id))) return json({ error: "Project not found." }, 404);
  const fnId = req.nextUrl.searchParams.get("fnId");
  if (!fnId) return json({ error: "fnId required." }, 400);
  await db.delete(serverlessFns).where(and(eq(serverlessFns.id, fnId), eq(serverlessFns.projectId, id)));
  return json({ ok: true });
}
