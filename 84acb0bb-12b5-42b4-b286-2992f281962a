import { NextRequest } from "next/server";
import bcrypt from "bcryptjs";
import { db } from "@/db";
import { users } from "@/db/schema";
import { eq } from "drizzle-orm";
import { createSession, rateLimit, clientIp, logSecurity, json } from "@/lib/auth";
import { ensureSeed } from "@/lib/platform";

export const runtime = "nodejs";

export async function POST(req: NextRequest) {
  await ensureSeed();
  const ip = clientIp(req);
  let body: { email?: string; password?: string };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Invalid request body." }, 400);
  }
  const email = (body.email ?? "").trim().toLowerCase();
  const password = body.password ?? "";
  if (!rateLimit(`login:${ip}:${email}`, 8, 60_000)) {
    await logSecurity("login.ratelimited", ip, `Rate limited for ${email}`);
    return json({ error: "Too many login attempts. Wait a minute and retry." }, 429);
  }
  const rows = await db.select().from(users).where(eq(users.email, email)).limit(1);
  const user = rows[0];
  if (!user || !user.passwordHash) {
    await logSecurity("login.failed", ip, `Unknown account ${email}`);
    return json({ error: "Invalid email or password." }, 401);
  }
  const ok = await bcrypt.compare(password, user.passwordHash);
  if (!ok) {
    await logSecurity("login.failed", ip, `Bad password for ${email}`, user.id);
    return json({ error: "Invalid email or password." }, 401);
  }
  if (user.suspended) {
    await logSecurity("login.blocked", ip, `Suspended account ${email}`, user.id);
    return json({ error: "This account has been suspended. Contact support." }, 403);
  }
  await createSession(user.id, req.headers.get("user-agent") ?? undefined, ip);
  await logSecurity("login.success", ip, `${email}`, user.id);
  return json({ user: { id: user.id, email: user.email, name: user.name, role: user.role, emailVerified: user.emailVerified, avatarHue: user.avatarHue } });
}
